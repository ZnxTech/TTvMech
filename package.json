{
	"name": "ttvmech",
	"version": "2.0.0-indev",
	"module": "dist/main.js",
	"type": "module",
	"private": true,
	"workspaces": [
		"modules/plugin-api",
		"modules/twitch-api"
	],
	"scripts": {
		"format": "prettier . --write",
		"build": "tsc --build",
		"build-all": "npm run build --workspaces && npm run build",
		"clean": "tsc --build --clean",
		"clean-all": "npm run clean --workspaces && npm run clean",
		"prestart": "npm run build-all && drizzle-kit migrate",
		"start": "node dist/main.js"
	},
	"dependencies": {
		"@ttvmech/plugin-api": "file:modules/plugin-api",
		"@ttvmech/twitch-api": "file:modules/twitch-api",
		"cookie-parser": "^1.4.7",
		"drizzle-kit": "^1.0.0-rc.4",
		"drizzle-orm": "^1.0.0-rc.4",
		"ejs": "^6.0.1",
		"express": "^5.2.1",
		"qs": "^6.15.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/ejs": "^3.1.5",
		"@types/express": "^5.0.6",
		"@types/qs": "^6.15.1",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2"
	}
}
