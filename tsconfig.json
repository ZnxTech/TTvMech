// Backend configs
{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["esnext", "DOM"],
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": ["node"],

    "outDir": "dist",

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
  },
  "include": ["main.ts", "src/**/*.ts"]
}
