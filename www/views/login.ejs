<!DOCTYPE html>
<head>
    <%- include("htmx.ejs") %>
    <title><%- meta.name %></title>
    <meta charset="utf-8">
    <meta name="application-name" content="<%- meta.name %>">
    <meta name="robots" content="none, nofollow, noindex">
    <link rel="stylesheet" href="/static/login.css">
</head>
<body>
    <header>
        <div id="title">
            <h1 id="title-name"><%- meta.name %></h1>
            <i id="title-version"><%- meta.version %></i>
        </div>
        <a class="bg-red btn tx-b" href="/dashboard">Back</a>
    </header>
    <main id="root" class="flx col s-center g-1">
        <form class="cnt"
            hx-post="/api/v1/users/auth"
            hx-swap="none">
            <section class="flx box col x-stretch g-1">
                <h2 class="s-center">Login:</h2>
                <div class="flx col">
                    <label>Username:</label>
                    <input name="user_name" type="text" required>
                </div>
                <div class="flx col">
                    <label>Password:</label>
                    <input name="user_pass" type="password" required>
                </div>
            </section>
            <button class="btn tx-b" type="submit">Submit</button>
        </form>
    </main>
</body>